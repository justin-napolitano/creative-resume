      "purpose": "Stable upload format when a system accepts PDF.",
      "preferred_extension": "pdf",
      "artifact_path": "public/resume.pdf",
      "structure": "single_column_text_first",
      "standard_headings_required": true,
      "layout_objects_allowed": false,
      "validation_gates": [
        "pdf_text_extractable",
        "contact_parse",
        "standard_heading_parse",
        "date_parse",
