      "artifact_path": "public/resume.pdf",
      "structure": "conservative_hierarchy",
      "standard_headings_required": true,
      "layout_objects_allowed": false,
      "validation_gates": [
        "skim_review",
        "print_readability",
        "no_generic_pitch_language",
