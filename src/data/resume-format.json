      "structure": "responsive_web",
      "standard_headings_required": false,
      "layout_objects_allowed": true,
      "validation_gates": [
        "canonical_content_sync",
        "public_privacy_gate",
        "route_health",
        "accessibility_baseline",
        "no_private_notes"
      ],
      "implementation_state": "available"
    },
    {
      "id": "targeted_job_application",
