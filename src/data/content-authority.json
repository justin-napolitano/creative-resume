{
  "version": 1,
  "repo_id": "creative-resume",
  "suite_id": "jnap-career-suite",
  "source_path": "src/data/resume.json",
  "owner_target": "resume",
  "authority": {
    "role": "central career content authority",
    "status": "initial_repo_local_store",
    "notes": [
      "src/data/resume.json is the first canonical store for shared public career facts.",
      "src/data/resume-format.json maps the platform resume-format contract into target-local output profiles and validation gates.",
      "Future database or service storage should preserve this schema contract first."
    ]
  },
  "public_fields": [
    "header.name",
    "header.location",
    "header.email",
    "header.github",
    "header.github_url",
    "header.linkedin",
    "header.linkedin_url",
    "summary",
    "education",
    "skills",
    "experience",
    "projects",
    "publications",
    "skill_highlights"
  ],
  "private_fields": [
    "header.phone"
  ],
  "canonical_entities": [
    "identity",
    "contact_channels",
    "locations",
    "professional_summary",
    "roles",
    "employers",
    "projects",
    "skills",
    "education",
    "certifications",
    "publications",
    "portfolio_links",
    "evidence_refs"
  ],
  "sync_targets": [
    {
      "target_id": "resume",
      "mode": "source",
      "outputs": ["public_resume_site", "pdf_resume", "cv_export", "content_api", "format_api"]
    },
    {
      "target_id": "docs",
      "mode": "projection",
      "outputs": ["evidence_catalog", "project_case_studies", "long_form_cv_context"]
    },
    {
      "target_id": "hire",
      "mode": "projection",
      "outputs": ["hiring_landing_page_copy", "proof_points", "contact_prompts"]
    },
    {
      "target_id": "link",
      "mode": "projection",
      "outputs": ["suite_navigation", "public_identity", "route_health"]
    }
  ],
  "api_surface": {
    "transport": "repo_local_json_cli",
    "entrypoint": "scripts/career-content-api.mjs",
    "commands": [
      "status",
      "profile",
      "sync-preview",
      "tailor-preview",
      "job-workflow",
      "job-normalize",
      "fit-report",
      "selection-plan",
      "review-packet",
      "reviewed-export",
      "format-status",
      "format-validate-source",
      "format-validate-export",
      "format-claim-audit"
    ]
  },
  "format_contract": {
    "path": "src/data/resume-format.json",
    "platform_contract_path": "/Users/justin/repos/codex_platform/plugins/jnap-career-suite/contracts/resume-format-contract.yaml",
    "commands": [
      {
        "id": "resume.format.status",
        "cli": "npm run resume.format.status"
      },
      {
        "id": "resume.format.validate-source",
        "cli": "npm run resume.format.validate-source"
      },
      {
        "id": "resume.format.validate-export",
        "cli": "npm run resume.format.validate-export -- --profile=web_resume"
      },
      {
        "id": "resume.format.claim-audit",
        "cli": "npm run resume.format.claim-audit -- --targeted-packet-json='{\"source_fact_ids\":[\"identity.name\"]}'"
      }
    ]
  },
  "rules": [
    "Commands must emit machine-readable JSON envelopes.",
    "Tailored resume previews must select from existing content only.",
    "Tailored resume previews must include source_fact_ids so claims can be audited.",
    "Job-targeting commands must keep job intake, fit scoring, selection planning, and review packets side-effect free.",
    "Review packets must include claim-audit state before any export worker can use them.",
    "Reviewed export commands must require explicit human approval before writing targeted application artifacts.",
    "Generated PDFs require human review before application submission.",
    "Application submission is out of scope for this authority bootstrap."
  ]
}
